<% content_for :title, "ホーム | #{@organization.service_name}" %>
<nav class="text-sm text-slate-500" aria-label="現在位置">ホーム</nav>
<header class="mt-3"><p class="text-sm text-slate-500"><%= l(Time.zone.today, format: :long) rescue Time.zone.today.strftime("%Y年%m月%d日") %></p><h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">今日も受付をスムーズに</h1><p class="mt-2 text-sm text-slate-600">まず、対応が必要な問い合わせを確認しましょう。</p></header>

<section class="mt-7" aria-labelledby="today-title">
  <div class="flex items-center justify-between"><h2 id="today-title" class="text-base font-bold">今日の受付</h2><%= link_to "問い合わせを見る", inquiries_path, class: "text-sm font-medium text-teal-700 hover:text-teal-900" %></div>
  <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-5">
    <% [ ["新規問い合わせ", @today_inquiries.count, "件"], ["対応必要", @today_inquiries.needs_action.count, "件"], ["予約", @today_appointments.count, "件"], ["営業時間外", @today_inquiries.where(outside_business_hours: true).count, "件"], ["AI完了率", @today_inquiries.count.zero? ? 0 : (@today_inquiries.where(ai_completed: true).count.fdiv(@today_inquiries.count) * 100).round, "%"] ].each_with_index do |(label, value, unit), index| %>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm <%= 'col-span-2 sm:col-span-1' if index == 4 %>"><p class="text-xs font-medium text-slate-500"><%= label %></p><p class="mt-2 text-2xl font-bold tracking-tight"><%= value %><span class="ml-1 text-sm font-normal text-slate-500"><%= unit %></span></p></div>
    <% end %>
  </div>
</section>

<section class="mt-8" aria-labelledby="tasks-title">
  <div class="flex items-end justify-between"><div><h2 id="tasks-title" class="text-xl font-bold">今やること</h2><p class="mt-1 text-sm text-slate-500">優先度が高い順です</p></div><span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800"><%= @tasks.size + (@new_questions.positive? ? 1 : 0) %>項目</span></div>
  <div class="mt-3 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <% if @tasks.any? %>
      <% @tasks.each_with_index do |inquiry, index| %><%= link_to inquiry_path(inquiry), class: "group flex items-center gap-4 border-b border-slate-100 px-4 py-4 last:border-0 hover:bg-slate-50 sm:px-6" do %>
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-slate-600"><%= index + 1 %></span>
        <div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><p class="truncate font-semibold"><%= inquiry.status == 'callback' ? '折り返し対応' : inquiry.status == 'new' ? '新しい問い合わせを確認' : '対応中の問い合わせを進める' %></p><span class="rounded-full px-2 py-0.5 text-xs ring-1 ring-inset <%= status_classes(inquiry.status) %>"><%= status_label(inquiry.status) %></span></div><p class="mt-1 truncate text-sm text-slate-500"><%= inquiry.customer.name %> — <%= inquiry.summary %></p></div>
        <span class="text-slate-400 group-hover:text-teal-700" aria-hidden="true">›</span>
      <% end %><% end %>
      <% if @new_questions.positive? %><%= link_to knowledge_index_path, class: "group flex items-center gap-4 px-4 py-4 hover:bg-slate-50 sm:px-6" do %><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-slate-600"><%= @tasks.size + 1 %></span><div class="flex-1"><p class="font-semibold">新しい質問の回答案を確認</p><p class="mt-1 text-sm text-slate-500"><%= @new_questions %>種類の改善候補があります</p></div><span class="text-slate-400 group-hover:text-teal-700">›</span><% end %><% end %>
    <% else %><div class="px-6 py-12 text-center"><p class="font-semibold">急ぎの対応はありません</p><p class="mt-2 text-sm text-slate-500">新しい対応が必要になると、優先順にここへ表示されます。</p></div><% end %>
  </div>
</section>

<section class="mt-8" aria-labelledby="results-title"><h2 id="results-title" class="text-base font-bold">今日の成果</h2><div class="mt-3 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-slate-200 bg-slate-200 sm:grid-cols-5"><% [ ["AI対応件数", @today_inquiries.where(ai_completed: true).count, "件"], ["削減時間", (@today_inquiries.where(ai_completed: true).count * 8 / 60.0).round(1), "時間"], ["予約", @today_appointments.count, "件"], ["商談", @today_inquiries.where(conversion_stage: %w[meeting contract]).count, "件"], ["成約", @today_inquiries.where(conversion_stage: "contract").count, "件"] ].each do |label, value, unit| %><div class="bg-white px-4 py-5"><p class="text-xs text-slate-500"><%= label %></p><p class="mt-2 text-xl font-bold"><%= value %><span class="ml-1 text-xs font-normal text-slate-500"><%= unit %></span></p></div><% end %></div></section>
