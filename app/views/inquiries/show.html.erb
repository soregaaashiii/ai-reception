<% content_for :title, "#{@inquiry.customer.name} | 問い合わせ" %>
<nav class="text-sm text-slate-500" aria-label="現在位置"><%= link_to "問い合わせ", inquiries_path, class: "hover:text-teal-700" %> › 詳細</nav>
<header class="sticky top-0 z-30 -mx-4 mt-3 border-b border-slate-200 bg-[#f7f8fa]/95 px-4 pb-4 pt-2 backdrop-blur sm:-mx-6 sm:px-6 lg:-mx-10 lg:px-10"><div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3"><div><div class="flex items-center gap-2"><h1 class="text-xl font-bold sm:text-2xl"><%= @inquiry.customer.name %></h1><span class="rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset <%= status_classes(@inquiry.status) %>"><%= status_label(@inquiry.status) %></span></div><p class="mt-1 text-xs text-slate-500"><%= l(@inquiry.received_at, format: :long) %> · <%= channel_label(@inquiry.channel) %></p></div><div class="flex flex-wrap gap-2"><%= link_to "電話", "tel:#{@inquiry.customer.phone}", class: "rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold" %><%= mail_to @inquiry.customer.email, "メール", class: "rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold" %><button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold" onclick="document.getElementById('assignment').showModal()">担当変更</button><%= link_to "予約", "#reservation", class: "rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold" %><%= button_to "完了", inquiry_path(@inquiry), method: :patch, params: { inquiry: { status: "completed" } }, class: "rounded-xl bg-teal-700 px-4 py-2 text-sm font-semibold text-white" %></div></div></header>

<div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.65fr)_minmax(300px,0.75fr)]">
  <div class="space-y-6"><section class="rounded-2xl border border-teal-100 bg-white p-5 shadow-sm sm:p-6"><p class="text-xs font-semibold text-teal-700">AIによる要約</p><h2 class="mt-2 text-lg font-bold"><%= @inquiry.summary %></h2><div class="mt-5 grid gap-4 border-t border-slate-100 pt-5 sm:grid-cols-2"><div><p class="text-xs text-slate-500">顧客の希望</p><p class="mt-1 text-sm"><%= @inquiry.customer_request %></p></div><div><p class="text-xs text-slate-500">次に必要な対応</p><p class="mt-1 text-sm font-semibold text-amber-800"><%= @inquiry.next_action %></p></div></div></section>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"><h2 class="font-bold">会話履歴</h2><div class="mt-5 space-y-5"><% @messages.each do |message| %><div class="flex gap-3 <%= 'flex-row-reverse' if message.speaker == 'ai' %>"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold <%= message.speaker == 'customer' ? 'bg-slate-100 text-slate-600' : 'bg-teal-50 text-teal-700' %>"><%= message.speaker == 'customer' ? '顧客' : message.speaker == 'ai' ? 'AI' : '担当' %></span><div class="max-w-[82%]"><p class="rounded-2xl px-4 py-3 text-sm leading-6 <%= message.speaker == 'customer' ? 'bg-slate-100' : 'bg-teal-50' %>"><%= message.content %></p><div class="mt-1 flex items-center gap-3 px-1 text-xs text-slate-400"><span><%= l(message.spoken_at, format: :time) %></span><%= button_to "AI知識へ登録", knowledge_draft_inquiry_path(@inquiry), method: :post, params: { message_id: message.id }, class: "font-medium text-teal-700 hover:text-teal-900" %></div></div></div><% end %></div></section>
  <details class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"><summary class="cursor-pointer font-bold">文字起こしを表示</summary><p class="mt-4 whitespace-pre-line text-sm leading-7 text-slate-600"><%= @inquiry.transcript %></p></details></div>
  <aside class="space-y-5"><section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">顧客情報</h2><dl class="mt-4 space-y-3 text-sm"><div><dt class="text-xs text-slate-500">電話番号</dt><dd class="mt-1"><%= @inquiry.customer.phone %></dd></div><div><dt class="text-xs text-slate-500">メール</dt><dd class="mt-1 break-all"><%= @inquiry.customer.email %></dd></div><div><dt class="text-xs text-slate-500">担当者</dt><dd class="mt-1"><%= @inquiry.assignee&.name || "未割当" %></dd></div></dl></section>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">通話録音</h2><p class="mt-3 text-sm"><%= @inquiry.recording_name.presence || "録音はありません" %></p><p class="mt-1 text-xs text-slate-500"><%= "#{@inquiry.recording_duration_seconds / 60}分#{@inquiry.recording_duration_seconds % 60}秒" if @inquiry.recording_duration_seconds %></p></section>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">AIが使用した知識</h2><div class="mt-3 space-y-2"><% @inquiry.knowledge_items.each do |item| %><p class="rounded-xl bg-slate-50 px-3 py-2 text-sm"><%= item.title %></p><% end %><%= content_tag(:p, "使用した知識はありません", class: "text-sm text-slate-500") if @inquiry.knowledge_items.empty? %></div></section>
  <section class="rounded-2xl border border-amber-200 bg-amber-50/60 p-5"><h2 class="font-bold text-amber-900">未回答箇所</h2><p class="mt-2 text-sm text-amber-900"><%= @inquiry.unanswered_portion.presence || "ありません" %></p></section>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">通知履歴</h2><div class="mt-3 space-y-3"><% @inquiry.notification_deliveries.order(created_at: :desc).each do |delivery| %><div class="text-sm"><p class="font-medium"><%= delivery.channel == 'email' ? 'メール' : 'Slack' %> · <%= delivery.status == 'sent' ? '送信済み' : '送信失敗' %></p><p class="mt-0.5 text-xs text-slate-500"><%= delivery.destination %></p></div><% end %></div></section>
  <% if (appointment = @inquiry.appointments.first) %><section id="reservation" class="scroll-mt-32 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">予約</h2><p class="mt-3 text-sm font-semibold"><%= appointment.title %></p><p class="mt-1 text-sm text-slate-500"><%= l(appointment.starts_at, format: :long) %></p></section><% end %>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">成約</h2><p class="mt-3 text-sm"><%= @inquiry.conversion_stage == 'contract' ? "成約済み（#{number_to_currency(@inquiry.revenue_yen, unit: '¥', precision: 0)}）" : "#{@inquiry.conversion_stage.presence || '未設定'}" %></p></section></aside>
</div>
<dialog id="assignment" class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/40"><%= form_with model: @inquiry, class: "p-6" do |f| %><h2 class="text-lg font-bold">担当者を変更</h2><p class="mt-1 text-sm text-slate-500">この問い合わせを引き継ぐ担当者を選びます。</p><%= f.select :assignee_id, @assignees.map { |u| [u.name, u.id] }, { include_blank: "未割当" }, class: "mt-5 w-full rounded-xl border-slate-300" %><div class="mt-6 flex justify-end gap-2"><button type="button" onclick="this.closest('dialog').close()" class="rounded-xl px-4 py-2 text-sm font-semibold text-slate-500">キャンセル</button><%= f.submit "変更する", class: "rounded-xl bg-teal-700 px-4 py-2 text-sm font-semibold text-white" %></div><% end %></dialog>
