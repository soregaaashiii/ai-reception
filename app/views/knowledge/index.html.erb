<% content_for :title, "AIの知識 | #{current_organization.service_name}" %>
<nav class="text-sm text-slate-500" aria-label="現在位置">AIの知識</nav>
<header class="mt-3"><h1 class="text-2xl font-bold tracking-tight sm:text-3xl">AIの知識</h1><p class="mt-2 text-sm text-slate-600">AIの回答を、人の確認を通して少しずつ育てます。</p></header>
<nav class="mt-7 flex gap-1 overflow-x-auto border-b border-slate-200" aria-label="AI知識の表示切替"><% [["改善候補", "candidates", current_organization.improvement_candidates.where(status: %w[pending later]).count], ["登録済み", "registered", current_organization.knowledge_items.count], ["履歴", "history", nil]].each do |label, tab, count| %><%= link_to knowledge_index_path(tab: tab), class: "whitespace-nowrap border-b-2 px-4 py-3 text-sm font-semibold #{@tab == tab ? 'border-teal-700 text-teal-800' : 'border-transparent text-slate-500 hover:text-slate-900'}" do %><%= label %><% if count %><span class="ml-1.5 rounded-full bg-slate-100 px-2 py-0.5 text-xs"><%= count %></span><% end %><% end %><% end %></nav>

<% if @tab == "candidates" %>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-3"><div><h2 class="font-bold">改善候補</h2><p class="mt-1 text-sm text-slate-500">問い合わせが多く、未回答のものから表示します。</p></div><%= form_with url: knowledge_index_path, method: :get, data: { turbo: false } do |f| %><%= f.hidden_field :tab, value: "candidates" %><%= f.select :sort, [["未回答順", "unanswered"], ["件数順", "count"], ["増加率順", "growth"], ["売上影響順", "sales"]], { selected: @sort }, class: "rounded-xl border-slate-300 text-sm", onchange: "this.form.submit()", aria: { label: "並び替え" } %><% end %></div>
  <div class="mt-4 space-y-4"><% if @candidates.any? %><% @candidates.each do |candidate| %><article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 <%= 'ring-2 ring-teal-500' if @selected_candidate == candidate %>"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-xs font-semibold text-teal-700"><%= candidate.category %></p><h3 class="mt-1 text-lg font-bold"><%= candidate.representative_question %></h3></div><div class="text-right"><p class="text-2xl font-bold"><%= candidate.inquiry_count %><span class="ml-1 text-xs font-normal text-slate-500">件</span></p><p class="text-xs text-slate-500">未回答 <%= candidate.unanswered_count %>件</p></div></div>
    <div class="mt-5 grid gap-5 lg:grid-cols-[0.85fr_1.4fr]"><div><p class="text-xs font-semibold text-slate-500">類似質問</p><ul class="mt-2 space-y-2 text-sm"><% candidate.similar_questions.each do |question| %><li class="rounded-xl bg-slate-50 px-3 py-2"><%= question %></li><% end %></ul><div class="mt-4 flex gap-4 text-xs text-slate-500"><span>増加率 <strong class="text-slate-800">+<%= candidate.growth_rate %>%</strong></span><span>売上影響 <strong class="text-slate-800"><%= { 'high' => '大', 'medium' => '中', 'low' => '小' }[candidate.sales_impact] %></strong></span></div></div><div class="rounded-xl border border-slate-200 bg-slate-50/50 p-4"><p class="text-xs font-semibold text-slate-500">AIの回答案</p><p class="mt-2 text-sm leading-6"><%= candidate.draft_answer %></p></div></div>
    <div class="mt-5 flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 pt-4"><%= button_to "後で確認", postpone_knowledge_path(candidate), method: :post, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-50" %><button type="button" class="rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50" onclick="document.getElementById('merge-<%= candidate.id %>').showModal()">既存へ統合</button><button type="button" class="rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50" onclick="document.getElementById('edit-<%= candidate.id %>').showModal()">編集して保存</button><%= button_to "この内容で保存", approve_knowledge_path(candidate), method: :post, class: "rounded-xl bg-teal-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-teal-800" %></div>
    <dialog id="merge-<%= candidate.id %>" class="m-auto w-[calc(100%-2rem)] max-w-xl rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/40"><%= form_with url: merge_knowledge_path(candidate), method: :post, class: "p-6" do |f| %><h3 class="text-lg font-bold">既存の知識へ統合</h3><p class="mt-2 text-sm text-slate-500">この質問を、内容が近い登録済み知識の類似質問として追加します。</p><div class="mt-5"><%= f.label :knowledge_item_id, "統合先", class: "text-sm font-semibold" %><%= f.collection_select :knowledge_item_id, @items, :id, :title, { prompt: "知識を選択" }, { required: true, class: "mt-2 w-full rounded-xl border-slate-300" } %></div><div class="mt-6 flex justify-end gap-2"><button type="button" onclick="this.closest('dialog').close()" class="rounded-xl px-4 py-2 text-sm font-semibold text-slate-500">キャンセル</button><%= f.submit "統合する", class: "rounded-xl bg-teal-700 px-4 py-2 text-sm font-semibold text-white" %></div><% end %></dialog>
    <dialog id="edit-<%= candidate.id %>" class="m-auto w-[calc(100%-2rem)] max-w-xl rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/40"><%= form_with url: approve_knowledge_path(candidate), method: :post, class: "p-6" do |f| %><h3 class="text-lg font-bold">回答案を編集して保存</h3><div class="mt-5"><%= f.label :question, "代表質問", class: "text-sm font-semibold" %><%= f.text_field :question, value: candidate.representative_question, class: "mt-2 w-full rounded-xl border-slate-300" %></div><div class="mt-4"><%= f.label :answer, "回答", class: "text-sm font-semibold" %><%= f.text_area :answer, value: candidate.draft_answer, rows: 5, class: "mt-2 w-full rounded-xl border-slate-300" %></div><div class="mt-6 flex justify-end gap-2"><button type="button" onclick="this.closest('dialog').close()" class="rounded-xl px-4 py-2 text-sm font-semibold text-slate-500">キャンセル</button><%= f.submit "確認して保存", class: "rounded-xl bg-teal-700 px-4 py-2 text-sm font-semibold text-white" %></div><% end %></dialog>
  </article><% end %><% else %><div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center"><p class="font-semibold">確認が必要な改善候補はありません</p><p class="mt-2 text-sm text-slate-500">AIが回答できなかった質問がまとまると、ここに表示されます。</p></div><% end %></div>
<% elsif @tab == "registered" %>
  <div class="mt-5 grid gap-4 sm:grid-cols-2"><% @items.each do |item| %><article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold text-teal-700"><%= item.category %></p><h2 class="mt-1 font-bold"><%= item.title %></h2></div><span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-800 ring-1 ring-inset ring-emerald-200">利用中</span></div><p class="mt-4 text-sm font-medium"><%= item.question %></p><p class="mt-2 line-clamp-3 text-sm leading-6 text-slate-600"><%= item.answer %></p><div class="mt-4 flex gap-4 border-t border-slate-100 pt-4 text-xs text-slate-500"><span>使用 <strong class="text-slate-800"><%= item.usage_count %>回</strong></span><span>解決 <strong class="text-slate-800"><%= item.resolution_count %>件</strong></span></div></article><% end %></div>
<% else %>
  <div class="mt-5 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><% @histories.each do |history| %><div class="flex gap-4 border-b border-slate-100 px-5 py-4 last:border-0"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-teal-600" aria-hidden="true"></span><div class="flex-1"><p class="text-sm"><strong><%= history.actor_name %></strong> が「<%= history.knowledge_item&.title || '削除済みの知識' %>」を<%= history.action %></p><p class="mt-1 text-xs text-slate-500"><%= history.summary %> · <%= l(history.created_at, format: :short) %></p></div></div><% end %><%= content_tag(:div, "更新履歴はまだありません。", class: "px-6 py-14 text-center text-sm text-slate-500") if @histories.empty? %></div>
<% end %>
