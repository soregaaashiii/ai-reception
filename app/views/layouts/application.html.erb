<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || current_organization&.service_name || "AI受付" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0f766e">
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-[#f7f8fa] text-slate-900 antialiased">
    <% if current_user %>
      <div class="min-h-screen lg:grid lg:grid-cols-[248px_1fr]">
        <aside class="border-b border-slate-200 bg-white lg:fixed lg:inset-y-0 lg:w-[248px] lg:border-b-0 lg:border-r">
          <div class="flex items-center justify-between px-5 py-5 lg:block">
            <div><p class="text-xl font-bold tracking-tight text-teal-800"><%= current_organization.service_name %></p><p class="mt-0.5 max-w-44 truncate text-xs text-slate-500"><%= current_organization.name %></p></div>
            <div class="text-right lg:mt-8 lg:text-left"><p class="text-sm font-medium"><%= current_user.name %></p><p class="text-xs text-slate-500"><%= current_user.role_label %></p></div>
          </div>
          <nav aria-label="主要メニュー" class="grid grid-cols-3 gap-1 border-t border-slate-100 px-3 py-3 text-sm sm:grid-cols-6 lg:grid-cols-1 lg:border-0 lg:px-4">
            <% [ ["ホーム", root_path, "home"], ["問い合わせ", inquiries_path, "inquiries"], ["AIの知識", knowledge_index_path, "knowledge"], ["予約", "#", "appointments"], ["分析", "#", "analytics"], ["設定", setup_path, "setups"] ].each do |label, path, key| %>
              <%= link_to path, class: "flex min-h-11 items-center justify-center rounded-xl px-3 py-2.5 font-medium transition lg:justify-start #{active_nav?(key) ? 'bg-teal-50 text-teal-800' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'}" do %><%= label %><% end %>
            <% end %>
          </nav>
          <div class="hidden px-5 lg:absolute lg:bottom-5 lg:block"><%= button_to "ログアウト", logout_path, method: :delete, class: "text-sm text-slate-500 hover:text-slate-900" %></div>
        </aside>
        <main class="min-w-0 lg:col-start-2">
          <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-10 lg:py-9">
            <div id="flash" aria-live="polite" class="fixed right-4 top-4 z-50 max-w-sm space-y-2">
              <% flash.each do |type, message| %><div class="rounded-xl border px-4 py-3 text-sm shadow-lg <%= type.to_s == 'alert' ? 'border-red-200 bg-red-50 text-red-800' : 'border-teal-200 bg-white text-teal-800' %>" role="<%= type.to_s == 'alert' ? 'alert' : 'status' %>"><%= message %></div><% end %>
            </div>
            <%= yield %>
          </div>
        </main>
      </div>
    <% else %><%= yield %><% end %>
  </body>
</html>
