<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || current_organization&.service_name || "AI受付" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0f766e">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <% if current_user %>
      <div class="min-h-screen lg:grid lg:grid-cols-[15rem_1fr]">
        <aside class="border-b border-slate-200 bg-white px-5 py-4 lg:border-b-0 lg:border-r">
          <div class="mb-6 flex items-center justify-between">
            <div><p class="text-lg font-bold text-teal-800"><%= current_organization.service_name %></p><p class="text-xs text-slate-500"><%= current_organization.name %></p></div>
            <%= button_to "ログアウト", logout_path, method: :delete, class: "text-sm text-slate-600" %>
          </div>
          <nav aria-label="主要メニュー" class="grid grid-cols-3 gap-2 text-sm lg:grid-cols-1">
            <% [ ["ホーム", root_path], ["問い合わせ", "#"], ["AIの知識", "#"], ["予約", "#"], ["分析", "#"], ["設定", "#"] ].each do |label, path| %>
              <%= link_to label, path, class: "rounded-lg px-3 py-2 #{label == 'ホーム' ? 'bg-teal-50 font-semibold text-teal-800' : 'text-slate-600 hover:bg-slate-50'}" %>
            <% end %>
          </nav>
        </aside>
        <main class="min-w-0 px-4 py-6 sm:px-8">
          <div aria-live="polite">
            <% flash.each do |type, message| %><p class="mb-4 rounded-lg border px-4 py-3 text-sm <%= type.to_s == 'alert' ? 'border-red-200 bg-red-50 text-red-800' : 'border-teal-200 bg-teal-50 text-teal-800' %>"><%= message %></p><% end %>
          </div>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
