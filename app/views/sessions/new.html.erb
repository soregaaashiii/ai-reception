<% content_for :title, "ログイン | AI受付" %>
<main class="flex min-h-screen items-center justify-center px-4 py-12">
  <section class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-7 shadow-sm" aria-labelledby="login-title">
    <p class="mb-2 text-sm font-semibold text-teal-700">AI受付</p>
    <h1 id="login-title" class="text-2xl font-bold">管理画面にログイン</h1>
    <p class="mt-2 text-sm text-slate-600">所属企業から案内されたメールアドレスを入力してください。</p>
    <% if flash[:alert] %><p class="mt-5 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><%= flash[:alert] %></p><% end %>
    <%= form_with url: session_path, class: "mt-6 space-y-5" do |form| %>
      <div><%= form.label :email, "メールアドレス", class: "mb-1 block text-sm font-medium" %><%= form.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "w-full rounded-lg border border-slate-300 px-3 py-2.5" %></div>
      <div><%= form.label :password, "パスワード", class: "mb-1 block text-sm font-medium" %><%= form.password_field :password, required: true, autocomplete: "current-password", class: "w-full rounded-lg border border-slate-300 px-3 py-2.5" %></div>
      <%= form.submit "ログイン", class: "w-full rounded-lg bg-teal-700 px-4 py-3 font-semibold text-white hover:bg-teal-800" %>
    <% end %>
  </section>
</main>
