<% content_for :title, "初期設定 | #{current_organization.service_name}" %>
<div class="mx-auto max-w-3xl">
  <nav class="text-sm text-slate-500" aria-label="現在位置">設定 › 初期設定</nav>
  <header class="mt-3"><h1 class="text-2xl font-bold sm:text-3xl">受付を始める準備</h1><p class="mt-2 text-sm text-slate-600">入力内容はステップごとに保存されます。いつでも続きから再開できます。</p></header>
  <div class="mt-7" aria-label="初期設定の進捗"><div class="flex items-center justify-between text-xs font-medium text-slate-500"><span>ステップ <%= @step %> / 6</span><span><%= (@step.fdiv(6) * 100).round %>%</span></div><div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-200"><div class="h-full rounded-full bg-teal-600 transition-all" style="width: <%= @step.fdiv(6) * 100 %>%"></div></div><ol class="mt-3 hidden grid-cols-6 gap-2 text-center text-xs sm:grid"><% %w[会社情報 営業時間 担当者 通知 AI知識 確認].each_with_index do |label, index| %><li class="<%= index + 1 == @step ? 'font-bold text-teal-700' : 'text-slate-400' %>"><%= label %></li><% end %></ol></div>

  <section class="mt-7 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
    <% if @step == 1 %>
      <h2 class="text-xl font-bold">会社情報</h2><p class="mt-1 text-sm text-slate-500">受付で名乗る会社とサービスの情報です。</p>
      <%= form_with model: @organization, url: setup_path(step: 1), method: :patch, class: "mt-6 space-y-5" do |f| %><%= hidden_field_tag :step, 1 %>
        <%= render "shared/form_field", form: f, field: :name, label: "会社名", placeholder: "例：試作株式会社" %>
        <%= render "shared/form_field", form: f, field: :service_name, label: "サービス名", placeholder: "例：AI受付" %>
        <%= render "shared/form_field", form: f, field: :industry, label: "業種", placeholder: "例：工務店" %>
        <%= render "actions", step: @step, submit_label: "保存して次へ" %>
      <% end %>
    <% elsif @step == 2 %>
      <h2 class="text-xl font-bold">営業時間</h2><p class="mt-1 text-sm text-slate-500">営業時間外の問い合わせを自動判定します。</p>
      <%= form_with model: @organization, url: setup_path(step: 2), method: :patch, class: "mt-6 space-y-5" do |f| %><%= hidden_field_tag :step, 2 %>
        <fieldset><legend class="text-sm font-semibold">営業日</legend><div class="mt-2 flex flex-wrap gap-2"><% %w[月 火 水 木 金 土 日].each do |day| %><label class="flex min-h-11 items-center gap-2 rounded-xl border border-slate-200 px-3"><%= check_box_tag "organization[business_days][]", day, day.in?(@organization.business_days), class: "rounded border-slate-300 text-teal-600" %><%= day %></label><% end %></div></fieldset>
        <%= render "shared/form_field", form: f, field: :business_hours, label: "営業時間", placeholder: "例：9:00〜18:00" %>
        <div><%= f.label :holidays, "休業日", class: "block text-sm font-semibold" %><%= f.text_area :holidays, rows: 3, placeholder: "例：祝日、年末年始", class: "mt-2 w-full rounded-xl border border-slate-300 px-3 py-3 focus:border-teal-600 focus:ring-teal-600" %></div>
        <%= render "actions", step: @step, submit_label: "保存して次へ" %>
      <% end %>
    <% elsif @step == 3 %>
      <h2 class="text-xl font-bold">担当者</h2><p class="mt-1 text-sm text-slate-500">問い合わせを引き継ぐ担当者を1名登録します。</p>
      <%= form_with model: @staff, url: setup_path(step: 3), method: :patch, class: "mt-6 space-y-5" do |f| %><%= hidden_field_tag :step, 3 %>
        <%= render "shared/form_field", form: f, field: :name, label: "名前", placeholder: "例：山田 太郎" %><%= render "shared/form_field", form: f, field: :email, label: "メール", placeholder: "例：yamada@example.jp", type: :email %><%= render "shared/form_field", form: f, field: :phone, label: "電話番号", placeholder: "例：03-1234-5678", type: :tel %>
        <%= render "actions", step: @step, submit_label: "保存して次へ" %>
      <% end %>
    <% elsif @step == 4 %>
      <h2 class="text-xl font-bold">通知</h2><p class="mt-1 text-sm text-slate-500">重要な問い合わせを受け取る場所を設定します。Slackは表示名またはチャンネル名だけで構いません。</p>
      <%= form_with model: @organization, url: setup_path(step: 4), method: :patch, class: "mt-6 space-y-5" do |f| %><%= hidden_field_tag :step, 4 %><%= render "shared/form_field", form: f, field: :notification_email, label: "通知メール", placeholder: "例：reception@example.jp", type: :email %><%= render "shared/form_field", form: f, field: :slack_destination, label: "Slack通知先", placeholder: "例：#お問い合わせ" %><%= render "actions", step: @step, submit_label: "保存して次へ" %><% end %>
    <% elsif @step == 5 %>
      <h2 class="text-xl font-bold">AI知識</h2><p class="mt-1 text-sm text-slate-500">AIが回答を考える際の資料です。今は入力だけ保存し、公開はしません。</p>
      <%= form_with model: @organization, url: setup_path(step: 5), method: :patch, class: "mt-6 space-y-5" do |f| %><%= hidden_field_tag :step, 5 %><%= render "shared/form_field", form: f, field: :website_url, label: "Webサイト", placeholder: "https://example.jp", type: :url %><div><%= f.label :initial_faq, "FAQ", class: "block text-sm font-semibold" %><%= f.text_area :initial_faq, rows: 4, placeholder: "よくある質問と回答を貼り付けてください", class: "mt-2 w-full rounded-xl border border-slate-300 px-3 py-3" %></div><div><%= f.label :initial_materials, "資料", class: "block text-sm font-semibold" %><%= f.text_area :initial_materials, rows: 3, placeholder: "資料名や保存場所を入力してください", class: "mt-2 w-full rounded-xl border border-slate-300 px-3 py-3" %></div><%= render "actions", step: @step, submit_label: "保存して確認へ" %><% end %>
    <% else %>
      <h2 class="text-xl font-bold">設定内容を確認</h2><p class="mt-1 text-sm text-slate-500">間違いがあれば各ステップへ戻って修正できます。</p>
      <dl class="mt-6 divide-y divide-slate-100"><% [ ["会社", @organization.name], ["サービス名", @organization.service_name], ["業種", @organization.industry], ["営業時間", "#{@organization.business_days.join('・')} #{@organization.business_hours}"], ["担当者", @staff.name], ["通知", [@organization.notification_email, @organization.slack_destination].compact_blank.join(' / ')], ["Webサイト", @organization.website_url] ].each do |label, value| %><div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr]"><dt class="text-sm text-slate-500"><%= label %></dt><dd class="font-medium"><%= value.presence || "未入力" %></dd></div><% end %></dl>
      <div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between"><%= link_to "戻って修正", setup_path(step: 5), class: "rounded-xl px-4 py-3 text-center text-sm font-semibold text-slate-600 hover:bg-slate-50" %><%= button_to "AI受付を開始する", complete_setup_path, method: :post, class: "w-full rounded-xl bg-teal-700 px-6 py-3 font-semibold text-white shadow-sm hover:bg-teal-800 sm:w-auto" %></div>
    <% end %>
  </section>
</div>
